rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Products catalog: publicly readable
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(productId);
    }

    // Orders collection: users can create orders and read their own orders
    match /orders/{orderId} {
      allow read: if (isSignedIn() && existing().userId == request.auth.uid) || (!isSignedIn() && existing().userId == 'guest');
      allow create: if isValidId(orderId) && incoming().id == orderId;
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
      allow delete: if false;
    }

    // User private subcollections (wishlist, cart)
    match /users/{userId}/wishlist/{wishlistId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(wishlistId);
    }

    match /users/{userId}/cart/{cartId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidId(cartId);
    }

    // Newsletter subscribers
    match /subscribers/{subscriberId} {
      allow create: if isValidId(subscriberId) && incoming().email is string && incoming().email.size() <= 128;
      allow read, update, delete: if false;
    }
  }
}
