{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "E-commerce product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "image": { "type": "string", "maxLength": 2048 },
        "description": { "type": "string", "maxLength": 1000 },
        "sizes": { "type": "array" },
        "inStock": { "type": "boolean" },
        "tag": { "type": "string", "maxLength": 30 },
        "rating": { "type": "number" },
        "featured": { "type": "boolean" }
      },
      "required": ["id", "name", "category", "price", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "totalAmount": { "type": "number" },
        "items": { "type": "array" },
        "status": { "type": "string", "maxLength": 30 },
        "shippingAddress": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "customerEmail", "customerName", "totalAmount", "status", "createdAt"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "User saved wishlist product",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "productId", "createdAt"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Newsletter subscriber email",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public catalog of streetwear products"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders stored in Google Cloud Firestore"
    },
    "/users/{userId}/wishlist/{wishlistId}": {
      "schema": "WishlistItem",
      "description": "User saved wishlist items"
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Newsletter subscribers"
    }
  }
}
